# DeathPWN — copy to .env and edit (cp .env.example .env)
# .env is gitignored; committed template is .env.example. Env vars already set in the
# shell always win over .env (override=false).

# — Base URL (Ollama-compatible API) —
# Local (default): Ollama on this machine — no auth needed, api stays empty.
DEATHPWN_OLLAMA_HOST=http://127.0.0.1:11434
# Remote example (uncomment to use a remote provider; api must then be set):
# DEATHPWN_OLLAMA_HOST=https://api.example.com/v1

# — API key / token —
# Local Ollama: leave empty (no Authorization header sent when empty).
DEATHPWN_API_KEY=
# Remote example:
# DEATHPWN_API_KEY=sk-...

# — Model name —
DEATHPWN_MODEL=openbmb/minicpm5:latest
# Remote example:
# DEATHPWN_MODEL=gpt-4o-mini

# Optional aliases (also read if DEATHPWN_* above not set):
# BASE_URL / DEATHPWN_BASE_URL -> DEATHPWN_OLLAMA_HOST
# API_KEY  / DEATHPWN_API_TOKEN -> DEATHPWN_API_KEY
# MODEL_NAME / DEATHPWN_MODEL_NAME -> DEATHPWN_MODEL

# Other tunables (same names as before):
# DEATHPWN_TIMEOUT=12
# DEATHPWN_KEEP_ALIVE=30m
# DEATHPWN_NUM_PREDICT=128
# DEATHPWN_THINK=false
# DEATHPWN_SYSTEM_PROMPT=
# DEATHPWN_OUTPUT_DIR=
# DEATHPWN_FLAGBOARD_ROOT=
# DEATHPWN_ENV_FILE=/custom/path/to/.env
